# Use a single MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/your db name
JWT_SECRET=mysecretkey123
NEXTAUTH_SECRET=some_super_secret_value
NEXT_PUBLIC_MAPBOX_TOKEN=your mapbox api key
SKIP_PREFLIGHT_CHECK=true

# Email Configuration
EMAIL_USER=your email
EMAIL_PASSWORD=your password
# Note: For Gmail, use an App Password instead of your regular password
# To create an App Password: Google Account > Security > 2-Step Verification > App passwords

# Google Gemini API Configuration
# Get your API key from: https://ai.google.dev/
# 1. Sign in with your Google account
# 2. Create a project or use an existing one
# 3. Go to "Get API key" and create a new key
# 4. Copy and paste the key below
NEXT_PUBLIC_GEMINI_API_KEY=your api key
